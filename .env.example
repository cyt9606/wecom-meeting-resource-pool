APP_ENV=production
APP_BASE_URL=https://meeting.example.com
SESSION_SECRET=replace-with-at-least-32-random-characters
# Production can use a root-readable generated file instead:
# SESSION_SECRET_FILE=/home/app/.session-secret
DATABASE_URL=postgresql://meeting_pool:replace-me@127.0.0.1:5432/meeting_pool

WECOM_CORP_ID=
WECOM_APP_SECRET=
WECOM_AGENT_ID=
WECOM_MEETING_RESOURCE_USERIDS=advanced-user-1
WECOM_ADMIN_USERIDS=admin-user-1

POLICY_BUFFER_MINUTES=10
POLICY_MIN_LEAD_MINUTES=15
POLICY_MAX_DURATION_MINUTES=480
POLICY_MAX_ADVANCE_DAYS=90
POLICY_MAX_PENDING_PER_USER=10
ALLOW_TEST_AUTH=false
REQUIRE_WECOM_CLIENT=true
